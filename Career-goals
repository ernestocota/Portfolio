<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ernesto Cota | Career Goals</title>
    <link rel="stylesheet" href="style.css">
</head>

<body>

    <header>
        <h1>Ernesto Cota</h1>
        <p>Career Goals</p>

        <nav>
            <a href="resume.html">Resume</a>
            <a href="cover-letter.html">Cover Letter</a>
            <a href="career-goals.html">Career Goals</a>
        </nav>
    </header>

    <main>

        <section>
            <h2>My Career Goals</h2>

            <p>
                My goal is to continue building experience in networking, cybersecurity,
                programming, and systems administration. I want to become a stronger
                technical professional who can solve problems and support secure,
                reliable technology environments.
            </p>

            <img style="margin-left:160px;" src="images/professional-photo.jpg"
                 alt="Professional technology workspace"
                 class="career-image">
        </section>

        <section>
            <h2>My Enthusiastism</h2>

            <audio controls>
                <source src="images/wooo.mp3" type="audio/mpeg">
                Your browser does not support audio playback.
            </audio>
        </section>

        <section>
            <h2>The Energy I Can Bring to the Workplace Example:</h2>

            <video controls width="500">
                <source src="images/dancing.mp4" type="video/mp4">
                Your browser does not support video playback.
            </video>
        </section>

        <section>
            <h2>Contact Me</h2>

            <form action="https://wp.zybooks.com/form-viewer.php" method="post">

                <label for="first-name">First Name:</label>
                <input type="text" id="first-name" name="first-name" required>

                <label for="last-name">Last Name:</label>
                <input type="text" id="last-name" name="last-name" required>

                <label for="company-name">Company Name:</label>
                <input type="text" id="company-name" name="company-name">

                <label for="email">Email Address:</label>
                <input type="email" id="email" name="email" required>

                <label for="phone">Phone Number:</label>
                <input type="tel" id="phone" name="phone">

                <label for="message">Message:</label>
                <textarea id="message" name="message" rows="10" cols="40"></textarea>

                <p>Best Contact Time:</p>

                <input type="radio" id="am" name="contact-time" value="a.m.">
                <label for="am">a.m.</label>

                <input type="radio" id="pm" name="contact-time" value="p.m.">
                <label for="pm">p.m.</label>

                <input type="radio" id="anytime" name="contact-time" value="anytime">
                <label for="anytime">anytime</label>

                <br><br>

                <label for="contact-method">Preferred Contact Method:</label>

                <select id="contact-method" name="contact-method">
                    <option value="phone">phone</option>
                    <option value="email">email</option>
                    <option value="text">text</option>
                </select>

                <br><br>

                <input type="submit" value="Submit">
            </form>
        </section>

    </main>

    <footer>
        <p>&copy; 2026 Ernesto Cota | Personal Portfolio</p>
    </footer>

</body>
</html>